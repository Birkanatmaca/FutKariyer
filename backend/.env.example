LISTEN_ADDR=:8080
DATABASE_URL=postgres://futcareer:futcareer_local@localhost:5432/futcareer?sslmode=disable
SESSION_TTL=720h
ADMIN_ORIGIN=http://localhost:5175
# Optional trusted HTTPS endpoint for the provider-agnostic checkout adapter.
# Configure both values together; use a random secret with at least 32 bytes.
# PAYMENT_ADAPTER_URL=https://payments.example.com/futcareer/checkout
# PAYMENT_ADAPTER_SECRET=
# In-app purchases. App Store transactions are verified offline against Apple's
# root certificate; Google Play needs a service account with financial data access.
# APPLE_BUNDLE_ID=com.futcareer
# GOOGLE_PLAY_PACKAGE_NAME=com.futcareer
# GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/run/secrets/google-play.json
# Push notifications through Firebase Cloud Messaging (service account JSON of the Firebase project).
# FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase.json
# Set when serving a built frontend directly from Go (and change ADMIN_ORIGIN).
# ADMIN_FRONTEND_DIR=../frontend/dist

# Only cmd/admin reads these variables; no default administrator credentials.
# ADMIN_FULL_NAME=
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_ADULT_CONFIRMED=true

# League data. Major leagues come from ESPN's public site API (no key); TFF Ankara
# from its public standings page. The base URLs are only overridden in tests.
# ESPN_BASE_URL=https://site.api.espn.com
# TFF_ANKARA_BASE_URL=https://sistem.tffankara.org
