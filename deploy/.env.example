# Copy to .env on the server and fill in. Generate the password with: openssl rand -hex 24
POSTGRES_PASSWORD=
# The admin panel origin (scheme + host[:port]); use https:// once a domain and TLS are set up.
ADMIN_ORIGIN=http://153.56.210.50
# Until a domain and TLS exist, the admin panel can be served over plain HTTP only
# with this explicit opt-in (sessions are then unencrypted). Remove it once HTTPS works.
ADMIN_ALLOW_INSECURE_HTTP=false
# Email for verification and password-reset codes (20 Oct 2026). Leave
# MAIL_PROVIDER empty until a sending domain is set up: verification is then
# not required and "Şifremi unuttum" says email is not available yet.
# Never use MAIL_PROVIDER=log here: codes would be written to the logs.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=
