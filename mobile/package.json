{
  "name": "FutCareer",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "node scripts/react-native.cjs run-android",
    "ios": "react-native run-ios",
    "lint": "eslint App.tsx src __tests__ scripts/react-native.cjs web vite.config.mjs --max-warnings 0",
    "start": "react-native start",
    "web": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build:web": "vite build --mode preview",
    "preview:web": "vite preview --host 127.0.0.1 --port 5174 --strictPort",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write App.tsx src __tests__ scripts web vite.config.mjs index.html",
    "build:android": "node scripts/react-native.cjs build-android --tasks assembleDebug"
  },
  "dependencies": {
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "lucide-react-native": "^1.52.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.84.1",
    "react-native-iap": "^16.7.2",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-controller": "1.22.6",
    "react-native-keychain": "^10.0.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.28.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "^15.15.5",
    "react-native-video": "^6.19.3",
    "react-native-view-shot": "^6.1.0",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "0.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
